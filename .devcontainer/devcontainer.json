{
  "name": "DevOps Foundations",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "containerEnv": {
    "AWS_PAGER": "",
    "K3D_CLUSTER_NAME": "devops-foundations",
    "KUBECONFIG": "/home/vscode/.kube/config",
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/.devcontainer/.mise.toml",
    "MISE_TRUSTED_CONFIG_PATHS": "/"
  },
  "remoteEnv": {
    "PATH": "/home/codespace/.local/bin:/home/codespace/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "onCreateCommand": ".devcontainer/setup.sh",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "vervium-cloud-ai",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "linkedinlearning.linkedinlearning-vscode-theme",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  }
}
// DevContainer Reference: https://code.visualstudio.com/docs/remote/devcontainerjson-reference