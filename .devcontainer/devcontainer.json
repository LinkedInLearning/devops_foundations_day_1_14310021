{
  "name": "DevOps Foundations",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  },
  "containerEnv": {
    "AWS_PAGER": "",
    "K3D_CLUSTER_NAME": "devops-foundations",
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/.devcontainer/.mise.toml",
    "MISE_TRUSTED_CONFIG_PATHS": "/",
    "MISE_K3D_VERSION": "5.8.3"
  },
  "remoteEnv": {
    "PATH": "/home/codespace/.local/bin:/home/codespace/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "onCreateCommand": ".devcontainer/setup.sh",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "vervium-cloud-ai",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "remote.extensionKind": {
          "HashiCorp.HCL": [
            "ui"
          ]
        }
      },
      "extensions": [
        "linkedinlearning.linkedinlearning-vscode-theme",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "HashiCorp.HCL"
      ]
    }
  }
}
